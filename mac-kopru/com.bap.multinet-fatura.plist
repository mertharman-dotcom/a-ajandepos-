<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.bap.multinet-fatura</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>/Users/Handan/bap-kopru/multinet.mjs</string>
    <string>--fatura-zamanli</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/Handan/bap-kopru</string>
  <key>StandardOutPath</key><string>/Users/Handan/bap-kopru/multinet_cron.log</string>
  <key>StandardErrorPath</key><string>/Users/Handan/bap-kopru/multinet_cron.log</string>
  <!-- Salı (Weekday 2) 23:30 — Multinet faturası, 3 gün vade (sahibin kuralı 06.10) -->
  <key>StartCalendarInterval</key>
  <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>23</integer><key>Minute</key><integer>30</integer></dict>
</dict>
</plist>
